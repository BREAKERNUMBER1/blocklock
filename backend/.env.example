# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Ethereum RPC — Alchemy
# Sepolia testnet:
ALCHEMY_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Mainnet (swap when going live):
# ALCHEMY_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Contract Addresses
# Sepolia test addresses (filled in after running: npm run deploy:sepolia in /contracts)
NFT_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_MOCK_NFT_ADDRESS
GOOF_TOKEN_ADDRESS=0xYOUR_DEPLOYED_MOCK_GOOF_ADDRESS
# Mainnet addresses (uncomment when going live):
# NFT_CONTRACT_ADDRESS=0xf1987f66553460a4f0730ce17484f5a9a2e883a6
# GOOF_TOKEN_ADDRESS=0x84802079Fde7658F9D0969810693a2FA1870EEdF

# Treasury — where 1 $GOOF is sent on each unlock
TREASURY_WALLET=0xYOUR_TREASURY_WALLET_ADDRESS

# Security — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_LONG_RANDOM_STRING_HERE
MQTT_HMAC_SECRET=GENERATE_ANOTHER_LONG_RANDOM_STRING_HERE

# MQTT Broker (Mosquitto on your DigitalOcean server)
MQTT_BROKER_URL=mqtts://YOUR_SERVER_IP:8883
MQTT_USERNAME=blocklock
MQTT_PASSWORD=GENERATE_A_STRONG_PASSWORD_HERE

# Discord webhook for unlock notifications (optional — leave blank to disable)
DISCORD_WEBHOOK_URL=

# Nonce expiry in seconds
NONCE_TTL_SECONDS=120

# Session token expiry in seconds (must complete tx within this window)
SESSION_TTL_SECONDS=300
